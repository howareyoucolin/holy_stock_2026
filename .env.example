# Remote MySQL connection. Copy to .env and fill in real values.
# .env is gitignored — never commit credentials.

DB_HOST=your-remote-mysql-host.example.com
DB_PORT=3306
DB_DATABASE=holy_stock
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_CHARSET=utf8mb4

# Optional: overrides everything above when set, e.g. for a socket or a
# provider-supplied DSN.
# DB_DSN=mysql:host=...;port=3306;dbname=...;charset=utf8mb4
