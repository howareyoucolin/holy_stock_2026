# Database settings for LOCAL DEVELOPMENT. Copy to .env.
# Production does not use this file — deploy/deploy.sh generates config.php on
# the server from deploy/remote.env instead.
#
# The MySQL user is granted only from the provider's own subnet, so a direct
# connection from this machine is always refused. Local dev goes through the SSH
# tunnel instead:
#
#     ./bin/db-tunnel.sh --docker
#
# host.docker.internal + port 13307 is how the php container reaches that tunnel.
# The app/ API server runs on the host and rewrites the host to 127.0.0.1 itself.

DB_HOST=host.docker.internal
DB_PORT=13307
DB_DATABASE=your_database_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_CHARSET=utf8mb4

# Where the console forwards a Publish request. The PHP site owns the write; the
# console only attaches the key from .secrets. Point this at
# http://localhost:8301/publish.php to publish through the local container.
PUBLISH_ENDPOINT=https://your-site.example.com/publish.php
