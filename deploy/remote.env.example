#
# Copy this file to deploy/remote.env and fill in the SSH and production
# database details for the host the site is deployed to.
#
# remote.env is gitignored — this repository is public, so real hostnames,
# usernames and paths must never end up in a committed file.
#

REMOTE_HOST=ssh.example.com
REMOTE_USERNAME=your_username
REMOTE_PASSWORD=your_password
REMOTE_PATH=/home/your_username/example.com
REMOTE_PORT=22

PROD_DB_HOST=mysql.example.com
PROD_DB_PORT=3306
PROD_DB_NAME=your_database_name
PROD_DB_USER=your_prod_db_user
PROD_DB_PASSWORD=your_prod_db_password
PROD_DB_CHARSET=utf8mb4
