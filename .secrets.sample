# Publishing key for this machine. Copy to .secrets (gitignored) and set a value.
#
# Publishing an analysis sends this key to the PHP site, which compares md5(key)
# against the `secrets` table and records the matching row's name as
# `published_by`. Register a key with:
#
#     ./bin/add-secret.sh "Your Name"
#
# Use a long random value — the endpoint is public, and a short key is guessable.
# Generate one with:
#
#     openssl rand -hex 32
#
publish_secret=replace_me_with_openssl_rand_hex_32
